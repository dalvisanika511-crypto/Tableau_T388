      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_1657299071291392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='PRICE CATEGORY' datatype='string' name='[Calculation_1657299073056769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;300 THEN &quot;LUXURY&quot; ELSEIF [Price]&gt;150 THEN &quot;STANDARD&quot; ELSE &quot;BUDGET&quot; END' />
      </column>
      <column caption='COUNT OF HOTELS' datatype='integer' name='[Calculation_1657299075969026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1657299079979011]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Host Since]&lt;TODAY()THEN &quot;Active Host&quot; ELSE &quot;New Host&quot; END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_1657299080761348]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100&#13;&#10;THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;Less Reviewed&quot; END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_1657299082760198]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 1657299081814021] THEN &quot;Above Limit&quot; ELSE &quot;Below Limit&quot; END' />
      </column>
      <column caption='count' datatype='integer' name='[Calculation_1657299085279239]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Host_Since' datatype='date' name='[Calculation_1657299087732744]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Review Score Rating (Bin)' datatype='string' name='[Calculation_1657299091550217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (bin)]),&quot;Not Rated&quot;)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
